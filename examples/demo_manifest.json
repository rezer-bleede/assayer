      "columns": {
        "order_id": {
          "name": "order_id",
          "description": "Surrogate order key",
          "data_tests": ["unique", "not_null"]
        },
        "customer_id": { "name": "customer_id", "data_tests": ["not_null"] },
        "amount": { "name": "amount", "data_tests": ["not_null"] }
      },
      "config": { "materialized": "table" }
    },
    "model.shop.fct_revenue": {
      "resource_type": "model",
      "name": "fct_revenue",
      "depends_on": {
        "nodes": ["model.shop.stg_orders", "source.shop.raw.customers"]
      },
      "columns": {
        "order_id": { "name": "order_id", "data_tests": ["unique"] },
        "revenue": { "name": "revenue" }
      },
      "config": { "materialized": "incremental" }
    }
  },
  "sources": {
    "source.shop.raw.orders": {
      "source_name": "raw",
      "name": "orders",
      "identifier": "orders"
    },
    "source.shop.raw.customers": {
      "source_name": "raw",
      "name": "customers",
      "identifier": "customers"
    }
  },
  "seeds": {}
