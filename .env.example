# ---- App state store (internal) ----
POSTGRES_USER=qualitest
POSTGRES_PASSWORD=qualitest
POSTGRES_DB=qualitest
DB_PORT=55432
REDIS_PORT=56379

# ---- Ports ----
API_PORT=8010
WEB_PORT=3010
OLLAMA_PORT=11435

# ---- LLM (bring your own key) ----
# Pick one provider style. Any OpenAI-compatible endpoint works (incl. Ollama, vLLM, LiteLLM).
LLM_PROVIDER=openai           # openai | ollama | azure | openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Ollama example
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:14b

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_WS_URL=ws://localhost:8010

# ---- Security / limits ----
# Comma-separated list; empty = allow all (dev default)
CORS_ORIGINS=http://localhost:3010
SECRET_KEY=change-me
RUN_MAX_CHECKS=200
RUN_QUERY_TIMEOUT_SECONDS=300
RUN_MAX_ROW_SAMPLE=20

# ---- Logging ----
LOG_LEVEL=INFO