# ---- App state store (internal) ----
POSTGRES_USER=assayer
POSTGRES_PASSWORD=assayer
POSTGRES_DB=assayer
DB_PORT=55432
REDIS_PORT=56379

# ---- Ports ----
API_PORT=8010
WEB_PORT=3010
OLLAMA_PORT=11435

# ---- LLM ----
# The stack ships a local model runner and pulls the model for you on first
# boot, so this block works as-is — no key, no setup. Any OpenAI-compatible
# endpoint works too (OpenAI, Azure, vLLM, LiteLLM); see the block below.
LLM_PROVIDER=ollama           # openai | ollama | azure | openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:3b
LLM_TEMPERATURE=0.1
# Seconds for one model call before the agent falls back to its deterministic
# planner; retries multiply this. Raise both for a slow model on a CPU-only host.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=0
# The model the stack pulls into the local runner. Keep it in sync with
# LLM_MODEL above, or the agent asks for a model that was never pulled.
OLLAMA_MODEL=qwen2.5-coder:3b

# To use a hosted model instead, comment out the block above and uncomment this:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Hosted free tier: Groq. No credit card; keys start with gsk_ (console.groq.com).
# Limits per model on the free plan: 30 req/min, 1,000 req/day, 200K tokens/day.
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b

# ---- OpenUI authoring ----
# The agent writes each assistant turn as OpenUI Lang. If the model is slow or
# emits invalid code, the deterministic serializer is used instead.
OPENUI_AUTHOR_ENABLED=true
OPENUI_AUTHOR_MAX_TOKENS=1400

# ---- Frontend UI checks ----
UI_ENABLED=true
UI_CHECK_TIMEOUT_SECONDS=30
UI_NAV_TIMEOUT_SECONDS=15
UI_MAX_STEPS=25
UI_MAX_PAGES=12
UI_ARTIFACT_DIR=/data/ui-artifacts
UI_ALLOW_PRIVATE_HOSTS=true
UI_VISUAL_DEFAULT_TOLERANCE=0.005

# ---- macOS: run the model on the Apple GPU ----
# Docker cannot pass the Apple GPU to containers, so the bundled runner is
# CPU-only (~8 tok/s) there. On macOS `make up` skips the bundled runner
# automatically (other platforms keep it unchanged) and uses native Ollama
# with Metal (~40 tok/s). Install once:
#   brew install --cask ollama       # or download from https://ollama.com
#   ollama pull qwen2.5-coder:3b
# then uncomment below and apply with `make up` (or restart api/worker with
# `docker compose up -d api worker` — a plain restart does not re-read .env):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_TIMEOUT_SECONDS=180
# To show the model's live thinking in the chat, use a thinking-capable model
# instead (qwen2.5-coder never emits reasoning):
#   ollama pull qwen3.5:9b
# LLM_MODEL=qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:9b
# LLM_TEMPERATURE=0.6          # recommended for its reasoning mode
# LLM_TIMEOUT_SECONDS=600      # thinking runs long; give it room
# Reasoning needs context room, or it fills the window and never answers. Bake
# a wider window into a derived model (shares the layers, no extra download):
#   printf 'FROM qwen3.5:9b\nPARAMETER num_ctx 8192\n' > /tmp/q.ModelFile
#   ollama create qwen3.5:9b-8k -f /tmp/q.ModelFile
# LLM_MODEL=qwen3.5:9b-8k
# OLLAMA_MODEL=qwen3.5:9b-8k
# The bundled runner reads this instead (compose sets the default):
# OLLAMA_CONTEXT_LENGTH=16384
# To force the bundled runner on macOS anyway: make up BUNDLED=1
# (and remove/blank the LLM_BASE_URL override above so it defaults to
# http://ollama:11434/v1).

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_WS_URL=ws://localhost:8010

# ---- Security / limits ----
# Comma-separated list; empty = allow all (dev default)
CORS_ORIGINS=http://localhost:3010
SECRET_KEY=change-me
RUN_MAX_CHECKS=200
RUN_QUERY_TIMEOUT_SECONDS=300
RUN_MAX_ROW_SAMPLE=20

# ---- Source intake (git clone + folder upload share these) ----
# Code/config we are willing to read: above this a "model" is generated or
# machine-written and carries no readable lineage.
INTAKE_CODE_MAX_BYTES=131072
# Data files are profiled rather than read as source, so they get their own cap.
INTAKE_DATA_MAX_BYTES=8000000
INTAKE_DATA_MAX_FILES=50
# Total source text kept for lineage (manifest.json has its own budget).
INTAKE_TOTAL_MAX_BYTES=4000000

# ---- Logging ----
LOG_LEVEL=INFO
